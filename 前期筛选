clean_column_names <- function(df) {
  colnames(df) <- str_replace_all(colnames(df), "^\\ufeff", "")
  colnames(df) <- str_trim(colnames(df))
  return(df)
}

load_and_prep_raw <- function(file_path, type_label) {
  if (!file.exists(file_path)) stop("找不到文件: ", file_path)
  
  df <- read_csv(file_path, show_col_types = FALSE) %>% clean_column_names()
  
  if (type_label == "protein") {
    df <- df %>% mutate(
      feature_id   = as.character(Protein),
      feature_name = ifelse(!is.na(Gene) & Gene != "", as.character(Gene), as.character(Protein))
    )
  } else {
    df <- df %>% mutate(
      feature_id   = as.character(Compound_ID),
      feature_name = as.character(Name)
    )
  }
  
  return(df)
}


prep_numeric_matrix <- function(df) {
  all_samples <- unlist(expected_groups)
  present_samples <- intersect(all_samples, colnames(df))
  
  for (col in present_samples) {
    df[[col]] <- suppressWarnings(as.numeric(df[[col]]))
  }
  return(df)
}


