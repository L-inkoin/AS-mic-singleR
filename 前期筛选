calc_stats_and_filter <- function(df, dataset_name) {
  
  samples_wt8  <- intersect(expected_groups$wt_8w, colnames(df))
  samples_hf8  <- intersect(expected_groups$hf_8w, colnames(df))
  samples_hf21 <- intersect(expected_groups$hf_21w, colnames(df))
  
  res_list <- vector("list", nrow(df))
  
  for (i in seq_len(nrow(df))) {
    row <- df[i, ]
    f_id   <- row$feature_id
    f_name <- row$feature_name
    
    vec_wt8  <- as.numeric(row[samples_wt8])[is.finite(as.numeric(row[samples_wt8]))]
    vec_hf8  <- as.numeric(row[samples_hf8])[is.finite(as.numeric(row[samples_hf8]))]
    vec_hf21 <- as.numeric(row[samples_hf21])[is.finite(as.numeric(row[samples_hf21]))]
    
    if (length(vec_wt8) < 2 || length(vec_hf8) < 2 || length(vec_hf21) < 2) next
    
    m_wt8  <- mean(vec_wt8)
    m_hf8  <- mean(vec_hf8)
    m_hf21 <- mean(vec_hf21)
    
    denom1 <- if (m_wt8 == 0) 1e-6 else m_wt8
    denom2 <- if (m_hf8 == 0) 1e-6 else m_hf8
    
    fc_8w_vs_wt  <- m_hf8 / denom1
    fc_21w_vs_8w <- m_hf21 / denom2
    
    p_8w_vs_wt  <- tryCatch(t.test(vec_hf8, vec_wt8)$p.value, error = function(e) NA_real_)
    p_21w_vs_8w <- tryCatch(t.test(vec_hf21, vec_hf8)$p.value, error = function(e) NA_real_)
    
    trend_1 <- if (fc_8w_vs_wt > 1) "Up" else "Down"
    trend_2 <- if (fc_21w_vs_8w > 1) "Up" else "Down"
    

    pass_level1 <- (trend_1 == "Down" && trend_2 == "Down")
    

    pass_level2 <- FALSE
    if (pass_level1) {
      
      pass_level2 <- (fc_21w_vs_8w < fc_8w_vs_wt)
    }
    
    pass_level3 <- pass_level2 && (
      (!is.na(p_8w_vs_wt) && p_8w_vs_wt < 0.05) || 
        (!is.na(p_21w_vs_8w) && p_21w_vs_8w < 0.05)
    )
    
    res_list[[i]] <- tibble(
      feature_id = f_id,
      feature_name = f_name,
      mean_wt_8w = m_wt8,
      mean_hf_8w = m_hf8,
      mean_hf_21w = m_hf21,
      fc_8w_vs_wt = fc_8w_vs_wt,
      fc_21w_vs_8w = fc_21w_vs_8w,
      p_8w_vs_wt = p_8w_vs_wt,
      p_21w_vs_8w = p_21w_vs_8w,
      pass_level1 = pass_level1,
      pass_level2 = pass_level2,
      pass_level3 = pass_level3
    )
  }
  
  bind_rows(res_list)
}

protein_stats <- calc_stats_and_filter(protein_raw, "protein")
