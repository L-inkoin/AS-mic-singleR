calculate_group_means <- function(df, data_type) {
  res <- list()
  for (g_name in names(expected_groups)) {
    cols <- intersect(expected_groups[[g_name]], colnames(df))
    if (length(cols) == 0) next
    
    tmp <- df %>%
      select(feature_id, feature_name, all_of(cols)) %>%
      rowwise() %>%
      mutate(
        mean_value   = mean(c_across(all_of(cols)), na.rm = TRUE),
        median_value = median(c_across(all_of(cols)), na.rm = TRUE),
        sd_value     = sd(c_across(all_of(cols)), na.rm = TRUE),
        n_detected   = sum(is.finite(c_across(all_of(cols))))
      ) %>%
      ungroup() %>%
      mutate(
        data_type = data_type,
        group = g_name,
        group_label = unname(group_labels[g_name]),
        n_samples = length(cols)
      ) %>%
      select(data_type, feature_id, feature_name, group, group_label, n_samples, n_detected, mean_value, median_value, sd_value)
    res[[g_name]] <- tmp
  }
  bind_rows(res)
}

all_means_long <- bind_rows(
  calculate_group_means(protein_selected, "protein"),
  calculate_group_means(blood_selected, "blood_metabolite"),
  calculate_group_means(fecal_selected, "fecal_metabolite")
)

if (nrow(all_means_long) > 0) {
  all_means_wide <- all_means_long %>%
    select(data_type, feature_id, feature_name, group_label, mean_value, median_value, sd_value) %>%
    pivot_wider(
      id_cols = c(data_type, feature_id, feature_name),
      names_from = group_label,
      values_from = c(mean_value, median_value, sd_value),
      names_glue = "{.value}_{group_label}"
    )
  
  write_csv(all_means_wide, file.path(output_dir, "target_features_three_groups_mean_distribution.csv"))
}


make_boxplot_pdf <- function(df, data_type_name) {
  if (nrow(df) == 0) return(NULL)
  
  all_samples <- unlist(expected_groups)
  present_cols <- intersect(all_samples, colnames(df))
  
  plot_data <- df %>%
    select(feature_id, feature_name, all_of(present_cols)) %>%
    pivot_longer(cols = all_of(present_cols), names_to = "sample", values_to = "value") %>%
    mutate(
      group = case_when(
        sample %in% expected_groups$hf_21w ~ "21周高脂",
        sample %in% expected_groups$hf_8w  ~ "8周高脂",
        sample %in% expected_groups$wt_8w  ~ "8周正常",
        TRUE ~ NA_character_
      )
    ) %>%
    filter(!is.na(group), is.finite(value)) %>%
    mutate(group = factor(group, levels = c("8周正常", "8周高脂", "21周高脂")))
  
  feature_ids <- unique(plot_data$feature_id)
  page_ids <- split(feature_ids, ceiling(seq_along(feature_ids) / 12))
  
  pdf_path <- file.path(output_dir, paste0(data_type_name, "_distribution_boxplots.pdf"))
  pdf(pdf_path, width = 14, height = 10, onefile = TRUE)
  
  for (p_features in page_ids) {
    p_df <- plot_data %>%
      filter(feature_id %in% p_features) %>%
      mutate(feature_label = paste0(feature_name, "\n(", feature_id, ")"))
    
    p <- ggplot(p_df, aes(x = group, y = value, fill = group)) +
      geom_boxplot(width = 0.6, outlier.shape = NA, alpha = 0.75) +
      geom_jitter(width = 0.1, size = 0.8, alpha = 0.7) +
      facet_wrap(~ feature_label, scales = "free_y", ncol = 3) +
      scale_fill_manual(values = c("8周正常" = "#4DBBD5", "8周高脂" = "#E64B35", "21周高脂" = "#3C5488")) +
      labs(title = paste(data_type_name, "分组表达/定量分布"), x = NULL, y = "定量值") +
      theme_bw(base_size = 11) +
      theme(legend.position = "none", axis.text.x = element_text(angle = 45, hjust = 1))
    
    print(p)
  }
  dev.off()
  return(pdf_path)
}

make_boxplot_pdf(protein_selected, "protein")
make_boxplot_pdf(blood_selected, "blood_metabolite")
make_boxplot_pdf(fecal_selected, "fecal_metabolite")


# Pearson 

calculate_pearson_pairs <- function(protein_df, met_df, met_type_label) {
  
  all_samples <- unlist(expected_groups)
  common_samples <- intersect(intersect(colnames(protein_df), colnames(met_df)), all_samples)
  
  if (length(common_samples) < 5) {
    warning("共有样本不足 5 个，跳过 ", met_type_label, " 相关性计算。")
    return(tibble(protein = character(), metabolite = character(), correlation_R = numeric(), P_value = numeric()))
  }
  
  results <- list()
  idx <- 1
  
  for (i in seq_len(nrow(protein_df))) {
    p_row  <- protein_df[i, ]
    p_name <- paste0(p_row$feature_name, " (", p_row$feature_id, ")")
    p_vec  <- as.numeric(p_row[common_samples])
    
    for (j in seq_len(nrow(met_df))) {
      m_row  <- met_df[j, ]
      m_name <- paste0(m_row$feature_name, " (", m_row$feature_id, ")")
      m_vec  <- as.numeric(m_row[common_samples])
      
      valid <- is.finite(p_vec) & is.finite(m_vec)
      if (sum(valid) >= 5) {
        test_res <- tryCatch(cor.test(p_vec[valid], m_vec[valid], method = "pearson"), error = function(e) NULL)
        
        if (!is.null(test_res)) {
          results[[idx]] <- tibble(
            protein       = p_name,
            metabolite    = m_name,
            correlation_R = unname(test_res$estimate),
            P_value       = test_res$p.value
          )
          idx <- idx + 1
        }
      }
    }
  }
  
  res_df <- bind_rows(results)
  if (nrow(res_df) > 0) res_df <- res_df %>% arrange(P_value)
  return(res_df)
}

protein_blood_pearson <- calculate_pearson_pairs(protein_selected, blood_selected, "blood_metabolite")
protein_fecal_pearson <- calculate_pearson_pairs(protein_selected, fecal_selected, "fecal_metabolite")

write_csv(protein_blood_pearson, file.path(output_dir, "protein_blood_metabolite_pearson_correlation.csv"))
