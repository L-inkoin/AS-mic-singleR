fecal_stats   <- calc_stats_and_filter(fecal_filtered_step1, "fecal_metabolite")

# 根据 chosen_level 提取符合条件的目标 ID
get_selected_ids <- function(stats_df, level_str) {
  if (level_str == "Level1_Loose") {
    stats_df %>% filter(pass_level1) %>% pull(feature_id)
  } else if (level_str == "Level2_Strict") {
    stats_df %>% filter(pass_level2) %>% pull(feature_id)
  } else {
    stats_df %>% filter(pass_level3) %>% pull(feature_id)
  }
}

